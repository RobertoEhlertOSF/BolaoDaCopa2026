@model BolaoDaCopa2026.Models.Jogo

@{
    var ehMataMata = !string.IsNullOrWhiteSpace(Model.Fase)
        && !Model.Fase.StartsWith("Grupo ", StringComparison.OrdinalIgnoreCase);

    var mostrarVencedor = ehMataMata
        && Model.GolsSelecaoA.HasValue
        && Model.GolsSelecaoB.HasValue
        && Model.GolsSelecaoA.Value == Model.GolsSelecaoB.Value;
}

<h2>Editar Jogo: @(Model.SelecaoA?.Nome ?? "A definir") x @(Model.SelecaoB?.Nome ?? "A definir")</h2>

@if (TempData["Sucesso"] != null)
{
    <div class="alert alert-success mt-2">@TempData["Sucesso"]</div>
}

@if (TempData["Erro"] != null)
{
    <div class="alert alert-danger mt-2">@TempData["Erro"]</div>
}

<form asp-action="AtualizarDataHora" asp-route-id="@Model.Id" method="post" class="mb-4">
    <div>
        <label>Dia e horário</label>
        <input type="datetime-local"
               name="dataHora"
               value="@Model.DataHora.ToString("yyyy-MM-ddTHH:mm")"
               required />
    </div>

    <button type="submit" class="btn btn-primary mt-2">Salvar Dia/Horário</button>
</form>

<hr />

<h4>Atualizar Status</h4>

<form asp-action="AtualizarStatus" asp-route-id="@Model.Id" method="post" class="mb-4">
    <div>
        <label>Status</label>
        <select name="status" required>
            <option value="Agendado" selected="@(Model.Status == "Agendado")">Agendado</option>
            <option value="EmAndamento" selected="@(Model.Status == "EmAndamento")">Em andamento</option>
            <option value="Finalizado" selected="@(Model.Status == "Finalizado")">Finalizado</option>
        </select>
    </div>

    <small class="form-text text-muted">
        Para marcar como finalizado, o placar precisa estar preenchido abaixo.
    </small>

    <div>
        <button type="submit" class="btn btn-warning mt-2">Salvar Status</button>
    </div>
</form>

<hr />

<h4>Atualizar Resultado</h4>

<form asp-action="Finalizar" asp-route-id="@Model.Id" method="post" id="form-finalizar-jogo">
    <div>
        <label>@(Model.SelecaoA?.Nome ?? "Seleção A")</label>
        <input type="number"
               name="golsA"
               id="golsA"
               value="@(Model.GolsSelecaoA ?? 0)"
               min="0" />
    </div>

    <div>
        <label>@(Model.SelecaoB?.Nome ?? "Seleção B")</label>
        <input type="number"
               name="golsB"
               id="golsB"
               value="@(Model.GolsSelecaoB ?? 0)"
               min="0" />
    </div>

    @if (ehMataMata)
    {
        <div id="box-vencedor"
             class="mt-3 @(mostrarVencedor ? "" : "d-none")">
            <strong>Quem avançou / venceu?</strong>

            @if (Model.SelecaoAId.HasValue)
            {
                <div>
                    <label>
                        <input type="radio"
                               name="selecaoVencedoraId"
                               value="@Model.SelecaoAId"
                               checked="@(Model.SelecaoVencedoraId == Model.SelecaoAId)" />
                        @(Model.SelecaoA?.Nome ?? "Seleção A")
                    </label>
                </div>
            }

            @if (Model.SelecaoBId.HasValue)
            {
                <div>
                    <label>
                        <input type="radio"
                               name="selecaoVencedoraId"
                               value="@Model.SelecaoBId"
                               checked="@(Model.SelecaoVencedoraId == Model.SelecaoBId)" />
                        @(Model.SelecaoB?.Nome ?? "Seleção B")
                    </label>
                </div>
            }

            <small class="form-text text-muted">
                Necessário apenas se o placar do mata-mata terminar empatado.
            </small>
        </div>
    }

    <button type="submit" class="btn btn-success mt-2">Finalizar Jogo</button>
    <a asp-action="Index" class="btn btn-secondary mt-2">Cancelar</a>
</form>

@if (ehMataMata)
{
    <script>
        (function () {
            const golsA = document.getElementById("golsA");
            const golsB = document.getElementById("golsB");
            const boxVencedor = document.getElementById("box-vencedor");

            if (!golsA || !golsB || !boxVencedor) return;

            function atualizarBoxVencedor() {
                const valorA = golsA.value.trim();
                const valorB = golsB.value.trim();

                const deveMostrar =
                    valorA !== "" &&
                    valorB !== "" &&
                    Number(valorA) === Number(valorB);

                boxVencedor.classList.toggle("d-none", !deveMostrar);

                if (!deveMostrar) {
                    boxVencedor.querySelectorAll("input[type='radio']").forEach(function (radio) {
                        radio.checked = false;
                    });
                }
            }

            golsA.addEventListener("input", atualizarBoxVencedor);
            golsB.addEventListener("input", atualizarBoxVencedor);

            atualizarBoxVencedor();
        })();
    </script>
}
