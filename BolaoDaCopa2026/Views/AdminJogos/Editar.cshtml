@model BolaoDaCopa2026.Models.Jogo

<h2>Editar Jogo: @Model.SelecaoA.Nome x @Model.SelecaoB.Nome</h2>

@if (TempData["Sucesso"] != null)
{
    <div class="alert alert-success mt-2">@TempData["Sucesso"]</div>
}

@if (TempData["Erro"] != null)
{
    <div class="alert alert-danger mt-2">@TempData["Erro"]</div>
}

<form asp-action="AtualizarDataHora" asp-route-id="@Model.Id" method="post" class="mb-4">
    <div>
        <label>Dia e horario</label>
        <input type="datetime-local"
               name="dataHora"
               value="@Model.DataHora.ToString("yyyy-MM-ddTHH:mm")"
               required />
    </div>

    <button type="submit" class="btn btn-primary mt-2">Salvar Dia/Horario</button>
</form>

<hr />

<h4>Atualizar Status</h4>

<form asp-action="AtualizarStatus" asp-route-id="@Model.Id" method="post" class="mb-4">
    <div>
        <label>Status</label>
        <select name="status" required>
            <option value="Agendado" selected="@(Model.Status == "Agendado")">Agendado</option>
            <option value="EmAndamento" selected="@(Model.Status == "EmAndamento")">Em andamento</option>
            <option value="Finalizado" selected="@(Model.Status == "Finalizado")">Finalizado</option>
        </select>
    </div>

    <small class="form-text text-muted">
        Para marcar como finalizado, o placar precisa estar preenchido abaixo.
    </small>

    <div>
        <button type="submit" class="btn btn-warning mt-2">Salvar Status</button>
    </div>
</form>

<hr />

<h4>Atualizar Resultado</h4>

<form asp-action="Finalizar" asp-route-id="@Model.Id" method="post">
    <div>
        <label>@Model.SelecaoA.Nome</label>
        <input type="number" name="golsA" value="@Model.GolsSelecaoA ?? 0" min="0" />
    </div>

    <div>
        <label>@Model.SelecaoB.Nome</label>
        <input type="number" name="golsB" value="@Model.GolsSelecaoB ?? 0" min="0" />
    </div>

    <button type="submit" class="btn btn-success mt-2">Finalizar Jogo</button>
    <a asp-action="Index" class="btn btn-secondary mt-2">Cancelar</a>
</form>
