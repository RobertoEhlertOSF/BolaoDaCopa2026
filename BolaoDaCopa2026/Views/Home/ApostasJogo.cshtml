@model BolaoDaCopa2026.Models.ViewModels.ApostasDoJogoViewModel

@{
    ViewData["Title"] = "Apostas do Jogo";

    var ehMataMata = !string.IsNullOrWhiteSpace(Model.Jogo.Fase)
        && !Model.Jogo.Fase.StartsWith("Grupo ", StringComparison.OrdinalIgnoreCase);

    var nomeSelecaoA = Model.Jogo.SelecaoA?.Nome ?? "Seleção A";
    var nomeSelecaoB = Model.Jogo.SelecaoB?.Nome ?? "Seleção B";

    string? nomeSelecaoVencedoraOficial = null;

    if (ehMataMata)
    {
        if (Model.Jogo.SelecaoVencedoraId == Model.Jogo.SelecaoAId)
        {
            nomeSelecaoVencedoraOficial = Model.Jogo.SelecaoA?.Nome;
        }
        else if (Model.Jogo.SelecaoVencedoraId == Model.Jogo.SelecaoBId)
        {
            nomeSelecaoVencedoraOficial = Model.Jogo.SelecaoB?.Nome;
        }
    }
}

<div class="top-actions">
    <a asp-controller="Home"
       asp-action="Index"
       class="btn-voltar">
        ← Voltar para o início
    </a>
</div>

<header>
    <h1>Apostas do jogo</h1>
</header>

<div class="jogo-head">
    <span class="fase">@Model.Jogo.Fase</span>
    <strong>@(Model.Jogo.SelecaoA?.Nome ?? "A definir")</strong>
    <span class="placar-oficial">@(Model.Jogo.GolsSelecaoA?.ToString() ?? "-") - @(Model.Jogo.GolsSelecaoB?.ToString() ?? "-")</span>
    <strong>@(Model.Jogo.SelecaoB?.Nome ?? "A definir")</strong>
    <span class="data">@Model.Jogo.DataHora.ToString("dd/MM/yyyy HH:mm")</span>

    @if (!string.IsNullOrWhiteSpace(nomeSelecaoVencedoraOficial))
    {
        <span class="vencedor-oficial">Vencedor oficial: @nomeSelecaoVencedoraOficial</span>
    }
</div>

<div class="container apostas-jogo-container">
    <div class="apostas-tabela">
        <div class="apostas-header @(ehMataMata ? "apostas-header--mata-mata" : "")">
            <span>Usuário</span>
            <span>Palpite @nomeSelecaoA</span>
            <span>Palpite @nomeSelecaoB</span>
            @if (ehMataMata)
            {
                <span>Vencedor previsto</span>
            }
        </div>

        @foreach (var item in Model.ApostasPorJogador)
        {
            <div class="apostas-linha @(ehMataMata ? "apostas-linha--mata-mata" : "")">
                <span class="usuario">@item.NomeUsuario</span>

                @if (!item.EsqueceuApostar)
                {
                    <div class="palpite-item">
                        <span class="palpite-time-label">@nomeSelecaoA</span>
                        <span class="palpite">@item.GolsSelecaoA</span>
                    </div>

                    <div class="palpite-item">
                        <span class="palpite-time-label">@nomeSelecaoB</span>
                        <span class="palpite">@item.GolsSelecaoB</span>
                    </div>
                }
                else
                {
                    <span class="esqueceu @(ehMataMata ? "esqueceu--mata-mata" : "")">Esqueceu de apostar</span>
                    <span class="esqueceu-mobile">Esqueceu de apostar</span>
                }

                @if (ehMataMata && !item.EsqueceuApostar)
                {
                    <div class="vencedor-palpite-box">
                        <span class="vencedor-palpite-label">Vencedor previsto</span>
                        @if (!string.IsNullOrWhiteSpace(item.NomeSelecaoVencedoraPalpite))
                        {
                            <span class="vencedor-palpite">@item.NomeSelecaoVencedoraPalpite</span>
                        }
                        else
                        {
                            <span class="vencedor-palpite vencedor-palpite--vazio">-</span>
                        }
                    </div>
                }
            </div>
        }
    </div>
</div>

<style>
    .apostas-jogo-container {
        max-width: 1160px;
        margin-top: 20px;
        margin-bottom: 30px;
    }

    .jogo-head {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 10px;
        margin: 14px 0 10px;
    }

    .jogo-head .fase {
        padding: 3px 10px;
        border-radius: 999px;
        font-size: 12px;
        border: 1px solid rgba(255,255,255,.2);
    }

    .placar-oficial {
        background: rgba(255,255,255,.08);
        padding: 4px 10px;
        border-radius: 8px;
        font-weight: 800;
    }

    .jogo-head .data {
        opacity: .7;
        font-size: 13px;
    }

    .vencedor-oficial {
        padding: 4px 10px;
        border-radius: 999px;
        background: rgba(255, 203, 0, 0.16);
        color: #ffcb00;
        font-size: 12px;
        font-weight: 800;
    }

    .apostas-tabela {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .apostas-header,
    .apostas-linha {
        display: grid;
        grid-template-columns: 1.5fr 1fr 1fr;
        gap: 8px;
        align-items: center;
    }

    .apostas-header--mata-mata,
    .apostas-linha--mata-mata {
        grid-template-columns: 1.5fr 1fr 1fr 1.2fr;
    }

    .apostas-header {
        font-size: 12px;
        text-transform: uppercase;
        opacity: .7;
        font-weight: 700;
        padding: 0 6px;
    }

    .apostas-linha {
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 12px;
        padding: 12px;
    }

    .usuario {
        font-weight: 700;
        min-width: 0;
        word-break: break-word;
    }

    .palpite-item,
    .vencedor-palpite-box {
        display: flex;
        justify-content: center;
        align-items: center;
        min-width: 0;
    }

    .palpite-time-label,
    .vencedor-palpite-label {
        display: none;
    }

    .palpite,
    .vencedor-palpite {
        background: rgba(255, 203, 0, 0.16);
        color: #ffcb00;
        border-radius: 8px;
        text-align: center;
        font-weight: 800;
        padding: 6px;
    }

    .palpite {
        min-width: 56px;
    }

    .vencedor-palpite-box {
        flex-direction: column;
        gap: 6px;
    }

    .vencedor-palpite {
        width: 100%;
    }

    .vencedor-palpite--vazio {
        color: rgba(255,255,255,0.7);
        background: rgba(255,255,255,0.08);
    }

    .esqueceu {
        grid-column: 2 / 4;
        text-align: center;
        color: #ffcc00;
        font-weight: 700;
    }

    .esqueceu--mata-mata {
        grid-column: 2 / 5;
    }

    .esqueceu-mobile {
        display: none;
    }

    @@media (max-width: 900px) {
        .apostas-header {
            display: none;
        }

        .apostas-linha,
        .apostas-linha--mata-mata {
            grid-template-columns: 1fr;
            gap: 10px 8px;
        }

        .usuario {
            font-size: 1rem;
        }

        .palpite-item,
        .vencedor-palpite-box {
            justify-content: space-between;
            gap: 12px;
            padding: 10px 12px;
            border-radius: 10px;
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(255,255,255,0.08);
        }

        .palpite-time-label,
        .vencedor-palpite-label {
            display: block;
            font-size: 0.82rem;
            font-weight: 700;
            color: rgba(255,255,255,0.82);
            line-height: 1.2;
        }

        .palpite,
        .vencedor-palpite {
            min-width: 64px;
        }

        .vencedor-palpite-box {
            flex-direction: row;
        }

        .esqueceu,
        .esqueceu--mata-mata {
            display: none;
        }

        .esqueceu-mobile {
            display: block;
            grid-column: 1 / -1;
            color: #ffcc00;
            font-weight: 700;
            text-align: center;
            background: rgba(255, 203, 0, 0.08);
            border-radius: 8px;
            padding: 8px;
        }
    }
</style>
