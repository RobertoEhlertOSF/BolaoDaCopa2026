@page
@model BolaoDaCopa2026.Pages.Jogos.IndexModel

@functions {
    public string NomeSelecaoOuFallback(BolaoDaCopa2026.Models.Selecao? selecao, string? descricao)
    {
        return selecao?.Nome ?? descricao ?? "Não definido";
    }

    public string? BandeiraSelecaoOuFallback(BolaoDaCopa2026.Models.Selecao? selecao)
    {
        return selecao?.BandeiraUrl;
    }
}

<header>
    <h1>Jogos da Copa</h1>
</header>

<div class="container">

    <div class="fase">
        <h2>Fase de Grupos</h2>

        @foreach (var jogo in Model.Jogos)
        {
            var nomeSelecaoA = NomeSelecaoOuFallback(jogo.SelecaoA, jogo.DescricaoSelecaoA);
            var nomeSelecaoB = NomeSelecaoOuFallback(jogo.SelecaoB, jogo.DescricaoSelecaoB);
            var bandeiraSelecaoA = BandeiraSelecaoOuFallback(jogo.SelecaoA);
            var bandeiraSelecaoB = BandeiraSelecaoOuFallback(jogo.SelecaoB);

            <div class="jogo @(jogo.EstaAberto ? "aberto" : "fechado")">

                <div class="times">
                    <div class="time">
                        @if (!string.IsNullOrWhiteSpace(bandeiraSelecaoA))
                        {
                            <img src="@bandeiraSelecaoA" alt="@nomeSelecaoA">
                        }

                        @nomeSelecaoA
                    </div>

                    <div class="vs">vs</div>

                    <div class="time">
                        @if (!string.IsNullOrWhiteSpace(bandeiraSelecaoB))
                        {
                            <img src="@bandeiraSelecaoB" alt="@nomeSelecaoB">
                        }

                        @nomeSelecaoB
                    </div>
                </div>

                <div class="info">
                    <div>@jogo.DataHora.ToString("dd/MM/yyyy")</div>
                    <div>@jogo.DataHora.ToString("HH:mm")</div>
                </div>

                <div class="acao">
                    @if (jogo.EstaAberto)
                    {
                        <button class="btn btn-apostar">Apostar</button>
                    }
                    else
                    {
                        <span class="encerrado">Encerrado</span>
                    }
                </div>

            </div>
        }

    </div>

</div>
