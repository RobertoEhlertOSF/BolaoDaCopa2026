@model IEnumerable<BolaoDaCopa2026.Models.Jogo>
@using BolaoDaCopa2026.Models

<div class="top-actions">
    <a asp-controller="Home"
       asp-action="Index"
       class="btn-voltar">
        ← Voltar para o início
    </a>

    <div class="top-right">

        <a asp-controller="Apostas"
           asp-action="Campeao"
           class="btn-campeao">
            🏆 Meu campeão
        </a>

        <a asp-controller="Home"
           asp-action="Regras"
           class="btn-regras">
            Regras do bolão
        </a>

    </div>
</div>

@{
    var apostas = ViewBag.Apostas as List<Aposta>;
    var podeApostarPorJogo = ViewBag.PodeApostarPorJogo as Dictionary<int, bool> ?? new Dictionary<int, bool>();
    var statusPorJogo = ViewBag.StatusPorJogo as Dictionary<int, string> ?? new Dictionary<int, string>();
    var pontuacaoService = new PontuacaoService();
    var mensagemSucesso = TempData["Sucesso"] as string;
    var mensagemErro = TempData["Erro"] as string;

    var filtro = (string)(ViewBag.Filtro ?? "todos");
    var grupo = (string)(ViewBag.Grupo ?? "");
    var fase = (string)(ViewBag.Fase ?? "Grupo A");

    var fasesGrupo = new List<(string Valor, string Rotulo)>
    {
        ("Grupo A", "A"), ("Grupo B", "B"), ("Grupo C", "C"), ("Grupo D", "D"),
        ("Grupo E", "E"), ("Grupo F", "F"), ("Grupo G", "G"), ("Grupo H", "H"),
        ("Grupo I", "I"), ("Grupo J", "J"), ("Grupo K", "K"), ("Grupo L", "L")
    };

    var fasesMataMata = new List<(string Valor, string Rotulo)>
    {
        ("Segunda Fase", "2ª Fase"),
        ("Oitavas", "Oitavas"),
        ("Quartas", "Quartas"),
        ("Semifinal", "Semi"),
        ("Terceiro Lugar", "3º Lugar"),
        ("Final", "Final")
    };

    int? ResolverSelecaoVencedoraId(Jogo jogo, Aposta? aposta)
    {
        if (aposta == null || !PontuacaoService.EhFaseMataMata(jogo.Fase))
            return null;

        return PontuacaoService.ResolverSelecaoVencedoraId(
            aposta.SelecaoAId,
            aposta.SelecaoBId,
            aposta.GolsSelecaoA,
            aposta.GolsSelecaoB,
            aposta.SelecaoVencedoraId);
    }

    string? ObterNomeSelecaoVencedora(Jogo jogo, Aposta? aposta)
    {
        var selecaoVencedoraId = ResolverSelecaoVencedoraId(jogo, aposta);

        if (!selecaoVencedoraId.HasValue)
            return null;

        if (selecaoVencedoraId == jogo.SelecaoAId)
            return jogo.SelecaoA?.Nome;

        if (selecaoVencedoraId == jogo.SelecaoBId)
            return jogo.SelecaoB?.Nome;

        return null;
    }

}

<header>
    <h1>Meus Palpites</h1>
</header>

<div class="fase-nav">
    <div class="fase-titulo-wrap">
        <span class="fase-subtitulo">Escolha a fase</span>
        <div class="fase-titulo">@fase</div>
    </div>

    <div class="fase-nav-bloco">
        <span class="fase-nav-label">Grupos</span>
        <div class="fase-chips">
            @foreach (var item in fasesGrupo)
            {
                var ativo = string.Equals(fase, item.Valor, StringComparison.OrdinalIgnoreCase);

                <a class="fase-chip @(ativo ? "fase-chip--ativa" : "")"
                   asp-action="Index"
                   asp-route-fase="@item.Valor"
                   asp-route-filtro="@filtro"
                   asp-route-grupo="@grupo">@item.Rotulo</a>
            }
        </div>
    </div>

    <div class="fase-nav-bloco">
        <span class="fase-nav-label">Mata-mata</span>
        <div class="fase-chips fase-chips--mata-mata">
            @foreach (var item in fasesMataMata)
            {
                var ativo = string.Equals(fase, item.Valor, StringComparison.OrdinalIgnoreCase);

                <a class="fase-chip @(ativo ? "fase-chip--ativa" : "")"
                   asp-action="Index"
                   asp-route-fase="@item.Valor"
                   asp-route-filtro="@filtro"
                   asp-route-grupo="@grupo">@item.Rotulo</a>
            }
        </div>
    </div>
</div>

<div class="container apostas-container">

    @if (!string.IsNullOrWhiteSpace(mensagemSucesso))
    {
        <div class="toast-feedback toast-sucesso">@mensagemSucesso</div>
    }

    @if (!string.IsNullOrWhiteSpace(mensagemErro))
    {
        <div class="toast-feedback toast-erro">@mensagemErro</div>
    }

    <form method="get" class="filtros">
        <input type="hidden" name="fase" value="@fase" />

        <select name="filtro">
            <option value="todos" selected="@(filtro == "todos")">Mostrar todos</option>
            <option value="com" selected="@(filtro == "com")">Somente com palpite</option>
            <option value="sem" selected="@(filtro == "sem")">Somente sem palpite</option>
        </select>

        <button type="submit" class="btn-filtro">Aplicar</button>
    </form>

    <form asp-action="SalvarTodos" method="post" id="form-salvar-todos" class="filtros">
        <input type="hidden" name="fase" value="@fase" />
        <input type="hidden" name="filtro" value="@filtro" />
        <input type="hidden" name="grupo" value="@grupo" />

        <button type="submit" class="btn-filtro">Salvar todos os jogos</button>
    </form>

    <div class="lista-jogos">
        @foreach (var jogo in Model.OrderBy(j => j.DataHora))
        {
            var aposta = apostas?.FirstOrDefault(a => a.JogoId == jogo.Id);
            var ehMataMata = !string.IsNullOrWhiteSpace(jogo.Fase)
            && !jogo.Fase.StartsWith("Grupo ", StringComparison.OrdinalIgnoreCase);

            var podeApostar = podeApostarPorJogo.TryGetValue(jogo.Id, out var valorPodeApostar)
            ? valorPodeApostar
            : false;

            var statusJogo = statusPorJogo.TryGetValue(jogo.Id, out var valorStatus)
            ? valorStatus
            : "Em andamento";

            var jogoFinalizado =
            string.Equals(statusJogo, "Finalizado", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(jogo.Status, "Finalizado", StringComparison.OrdinalIgnoreCase);

            var jogoEmAndamento =
            string.Equals(statusJogo, "Em andamento", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(jogo.Status, "EmAndamento", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(jogo.Status, "Em andamento", StringComparison.OrdinalIgnoreCase);

            var podeVerApostasDoJogo = jogoFinalizado || jogoEmAndamento;
            var urlDetalheApostas = Url.Action("ApostasJogo", "Home", new { id = jogo.Id });
            var rotuloVencedor = jogo.Fase switch
            {
                "Final" => "Quem vence?",
                "Terceiro Lugar" => "Quem fica em 3o?",
                _ => "Quem avanca?"
            };

            int pontos = 0;
            int pontosBase = 0;
            string classePontos = "pontos-neutro";
            var nomeSelecaoEscolhida = ObterNomeSelecaoVencedora(jogo, aposta);

            if (jogoFinalizado && aposta != null && jogo.GolsSelecaoA.HasValue && jogo.GolsSelecaoB.HasValue)
            {
                pontosBase = pontuacaoService.CalcularPontuacaoApostador(
                    jogo.GolsSelecaoA.Value,
                    jogo.GolsSelecaoB.Value,
                    aposta.GolsSelecaoA,
                    aposta.GolsSelecaoB
                );

                pontos = aposta.Pontos;

                if (pontosBase == 10) classePontos = "pontos-exato";
                else if (pontosBase == 7 || pontosBase == 5 || pontos > pontosBase) classePontos = "pontos-parcial";
                else if (pontosBase == 2) classePontos = "pontos-minimo";
            }

            var statusCurto = statusJogo;

            <div class="jogo @(podeApostar ? "aberto" : "encerrado") @(podeVerApostasDoJogo ? "jogo-clickable" : "")"
                 data-detalhe-url="@(podeVerApostasDoJogo? urlDetalheApostas : "")">

                <div class="jogo-meta">
                    <div class="jogo-data">@jogo.DataHora.ToString("dd/MM/yy")</div>
                    <div class="jogo-status">@statusCurto</div>
                </div>

                <div class="jogo-times">
                    <div class="linha-time">
                        <div class="time">
                            <img src="@(jogo.SelecaoA?.BandeiraUrl ?? "https://placehold.co/80x50?text=--")"
                                 alt="@(jogo.SelecaoA?.Nome ?? "A definir")" />
                            <span class="nome-time">@(jogo.SelecaoA?.Nome ?? "A definir")</span>
                        </div>

                        @if (!podeApostar && aposta != null)
                        {
                            <span class="resultado-lateral">@aposta.GolsSelecaoA</span>
                        }
                    </div>

                    <div class="linha-time">
                        <div class="time">
                            <img src="@(jogo.SelecaoB?.BandeiraUrl ?? "https://placehold.co/80x50?text=--")"
                                 alt="@(jogo.SelecaoB?.Nome ?? "A definir")" />
                            <span class="nome-time">@(jogo.SelecaoB?.Nome ?? "A definir")</span>
                        </div>

                        @if (!podeApostar && aposta != null)
                        {
                            <span class="resultado-lateral">@aposta.GolsSelecaoB</span>
                        }
                    </div>
                </div>

                <div class="jogo-acao">
                    @if (podeApostar)
                    {
                        <form asp-action="Salvar" method="post" class="palpite">
                            <input type="hidden" name="fase" value="@fase" />
                            <input type="hidden" name="filtro" value="@filtro" />
                            <input type="hidden" name="grupo" value="@grupo" />
                            <input type="hidden" name="jogoId" value="@jogo.Id" />

                            <div class="placar">
                                <input type="number"
                                       name="golsSelecaoA"
                                       data-campo-aposta="golsSelecaoA"
                                       min="0"
                                       value="@aposta?.GolsSelecaoA" />

                                <span class="x">x</span>

                                <input type="number"
                                       name="golsSelecaoB"
                                       data-campo-aposta="golsSelecaoB"
                                       min="0"
                                       value="@aposta?.GolsSelecaoB" />
                            </div>

                            @if (ehMataMata)
                            {
                                var mostrarDesempate = aposta != null
                                && aposta.GolsSelecaoA == aposta.GolsSelecaoB;

                                <div class="desempate @(mostrarDesempate ? "" : "desempate-oculto")" data-desempate>
                                    <div class="desempate-titulo">@rotuloVencedor</div>

                                    @if (jogo.SelecaoAId.HasValue)
                                    {
                                        <label class="desempate-opcao">
                                            <input type="radio"
                                                   name="selecaoVencedoraId"
                                                   value="@jogo.SelecaoAId"
                                                   checked="@(aposta?.SelecaoVencedoraId == jogo.SelecaoAId)" />
                                            @(jogo.SelecaoA?.Nome ?? "Seleção A")
                                        </label>
                                    }

                                    @if (jogo.SelecaoBId.HasValue)
                                    {
                                        <label class="desempate-opcao">
                                            <input type="radio"
                                                   name="selecaoVencedoraId"
                                                   value="@jogo.SelecaoBId"
                                                   checked="@(aposta?.SelecaoVencedoraId == jogo.SelecaoBId)" />
                                            @(jogo.SelecaoB?.Nome ?? "Seleção B")
                                        </label>
                                    }
                                </div>
                            }

                            <button class="btn btn-salvar" type="submit">
                                @(aposta == null ? "Salvar" : "Atualizar")
                            </button>
                        </form>
                    }
                    else
                    {
                        <div class="resultado-fechado">
                            @if (jogoFinalizado && aposta != null)
                            {
                                <div class="resultado-finalizado">
                                    @if (!string.IsNullOrWhiteSpace(nomeSelecaoEscolhida))
                                    {
                                        <span class="quem-avancou">Vencedor previsto: @nomeSelecaoEscolhida</span>
                                    }

                                    <span class="pontos @classePontos">(@pontos pts)</span>
                                </div>
                            }
                            else
                            {
                                <span class="aposta-encerrada">Apostas encerradas</span>
                            }
                        </div>
                    }
                </div>

            </div>
        }
    </div>

</div>

<script>
    (function () {
        const formSalvarTodos = document.getElementById("form-salvar-todos");
        if (!formSalvarTodos) return;

        formSalvarTodos.addEventListener("submit", function () {
            formSalvarTodos.querySelectorAll("input[data-aposta-lote='true']").forEach((el) => el.remove());

            const formulariosPalpite = document.querySelectorAll("form.palpite");
            let indice = 0;

            formulariosPalpite.forEach(function (formPalpite) {
                const jogoIdInput = formPalpite.querySelector("input[name='jogoId']");
                const golsAInput = formPalpite.querySelector("input[data-campo-aposta='golsSelecaoA']");
                const golsBInput = formPalpite.querySelector("input[data-campo-aposta='golsSelecaoB']");
                const vencedorInput = formPalpite.querySelector("input[name='selecaoVencedoraId']:checked");

                const golsA = golsAInput ? golsAInput.value.trim() : "";
                const golsB = golsBInput ? golsBInput.value.trim() : "";

                if (!jogoIdInput || golsA === "" || golsB === "") return;

                adicionarInputLote("apostas[" + indice + "].JogoId", jogoIdInput.value);
                adicionarInputLote("apostas[" + indice + "].GolsSelecaoA", golsA);
                adicionarInputLote("apostas[" + indice + "].GolsSelecaoB", golsB);

                if (vencedorInput) {
                    adicionarInputLote("apostas[" + indice + "].SelecaoVencedoraId", vencedorInput.value);
                }

                indice++;
            });
        });

        function adicionarInputLote(name, value) {
            const input = document.createElement("input");
            input.type = "hidden";
            input.name = name;
            input.value = value;
            input.setAttribute("data-aposta-lote", "true");
            formSalvarTodos.appendChild(input);
        }
    })();

    (function () {
        const toasts = document.querySelectorAll(".toast-feedback");
        if (!toasts.length) return;

        toasts.forEach(function (toast) {
            setTimeout(function () {
                toast.classList.add("sumindo");
            }, 2600);

            setTimeout(function () {
                toast.remove();
            }, 3200);
        });
    })();

    (function () {
        const cards = document.querySelectorAll(".jogo.jogo-clickable[data-detalhe-url]");
        if (!cards.length) return;

        cards.forEach(function (card) {
            const destino = card.getAttribute("data-detalhe-url");
            if (!destino) return;

            card.addEventListener("click", function (event) {
                const alvo = event.target;
                if (!(alvo instanceof Element)) return;

                if (alvo.closest("input, button, select, textarea, label, form, a")) return;

                window.location.href = destino;
            });
        });
    })();

    (function () {
        document.querySelectorAll("form.palpite").forEach(function (form) {
            const golsAInput = form.querySelector("input[data-campo-aposta='golsSelecaoA']");
            const golsBInput = form.querySelector("input[data-campo-aposta='golsSelecaoB']");
            const desempate = form.querySelector("[data-desempate]");

            if (!golsAInput || !golsBInput || !desempate) return;

            function atualizarDesempate() {
                const golsA = golsAInput.value.trim();
                const golsB = golsBInput.value.trim();

                const deveMostrar = golsA !== "" && golsB !== "" && Number(golsA) === Number(golsB);

                desempate.classList.toggle("desempate-oculto", !deveMostrar);

                if (!deveMostrar) {
                    desempate.querySelectorAll("input[type='radio']").forEach(function (radio) {
                        radio.checked = false;
                    });
                }
            }

            golsAInput.addEventListener("input", atualizarDesempate);
            golsBInput.addEventListener("input", atualizarDesempate);

            atualizarDesempate();
        });
    })();
</script>

